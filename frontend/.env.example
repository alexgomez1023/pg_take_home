# Base URL of the StockData API, without a trailing slash.
# Leave empty during local development: requests then go to the same origin and the Vite dev
# server proxies /api to http://localhost:5080 (override the proxy target with VITE_API_PROXY_TARGET).
# Set it when the frontend is served separately from the API, e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
